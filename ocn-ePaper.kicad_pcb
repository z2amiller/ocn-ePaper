	(footprint "LowPower:EPD_GDEY0213B74_WrappedToBack_Hirose_FH34SRJ-24S-0.5SH"
		(layer "F.Cu")
		(uuid "f4b376fa-6b94-44da-871c-5b83b72b382d")
		(at 142.65 129.05)
		(descr "GDEY0213B74 e-paper panel bonded display-out to the back of the board, tail wrapped 180 degrees round the board edge into a Hirose FH34SRJ-24S-0.5SH(50) on top (LCSC C324726). Pad n = panel pin n, in the connector's own order (the reverse of the FoldedUnder build). Panel, its areas, the tail and the nominal board edge on Dwgs.User. Assumes a 1.6 mm board and 0.2 mm of adhesive under the panel (bend radius 1.4 mm). Nominal board edge 7.42 mm from the connector origin; it works from the panel edge out to 8.3 mm. Panel edge 5.17 mm from the origin, +-0.5 mm; the fold sticks out 1.5 mm past the nominal edge. F.CrtYd covers the connector, the tail on top and the fold; B.CrtYd covers the panel and the tail on the back, so the back must stay clear under the panel.")
		(tags "e-paper EPD GDEY0213B74 FPC FH34SRJ wrapped back")
